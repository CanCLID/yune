{
  "name": "@yune-ime/yune-web-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:smoke": "playwright test --config playwright.config.ts --grep @smoke",
    "test:e2e:input-latency": "playwright test --config playwright.latency.config.ts",
    "test:e2e:input-latency:public": "node run-public-latency-gate.mjs",
    "test:e2e:web06": "playwright test --config playwright.web06.config.ts --grep @web06-full --workers=1 --retries=0",
    "test:e2e:web06:public": "node run-public-web06-gate.mjs",
    "test:e2e:web06:preview-reconcile": "node run-public-web06-gate.mjs --scope preview-canary --verify-only",
    "test:e2e:web06:preview-canary": "node run-public-web06-gate.mjs --scope preview-canary",
    "test:web06-release-plumbing": "node --test run-public-web06-gate.test.mjs public-artifact-verifier.test.mjs && python3 -B -m unittest test_verify_archive_dist_identity.py"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0"
  }
}
